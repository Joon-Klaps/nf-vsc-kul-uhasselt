{
    "extends": "recommended",
    "rules": {
        "DuplicateNumberLiteral": {
            "enabled": false
        },
        "DuplicateStringLiteral": {
            "enabled": false
        },
        "JUnitLostTest": {
            "enabled": false
        },
        "JUnitPublicNonTestMethod": {
            "enabled": false
        },
        "JUnitTestMethodWithoutAssert": {
            "enabled": false
        },
        "MethodName": {
            "enabled": false
        },
        "Instanceof": {
            "enabled": false
        },
        "ParameterCount": {
            "enabled": false
        },
        "LineLength": {
            "length": 200
        }
    }
}
